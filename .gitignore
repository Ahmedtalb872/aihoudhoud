# Supabase local secrets (copy env.json.example -> env.json and fill in your own project)
env.json

# Release signing key - never commit this. CI reconstructs it at build time
# from repository secrets (see .github/workflows/build-apk.yml); for a local
# release build, generate your own and fill these in, they're gitignored.
android/key.properties
android/app/*.jks
